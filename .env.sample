# Finance Tracker Application - Environment Variables
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ============================================
# Application Mode
# ============================================
# Set to 'production' for production deployment (enables rate limiting, strict CORS, etc.)
# Set to 'development' for local development without Docker
NODE_ENV=production

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=finance_tracker
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ============================================
# Server Configuration
# ============================================
SERVER_PORT=8000
# Note: SERVER_HOST is not needed in docker-compose.yml
# Server defaults to 0.0.0.0 in main.ts (correct for Docker)

# ============================================
# Client Configuration
# ============================================
CLIENT_PORT=3000
# Note: CLIENT_HOST and SERVER_HOST are not needed in docker-compose.yml
# Docker containers bind to 0.0.0.0 by default (correct for Docker)

# ============================================
# Security Secrets
# ============================================
# Generate with: openssl rand -base64 32
# MUST be set in production (minimum 32 characters)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters
REFRESH_SECRET=your_jwt_secret_here_minimum_32_characters
INTERNAL_SECRET=your_jwt_secret_here_minimum_32_characters

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins (browser origins)
# Example: http://localhost:3000,https://yourdomain.com
# REQUIRED in production
# Must match the URL you use to access the frontend
ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# API Configuration
# ============================================
# NEXT_PUBLIC_API_BASE_URL: Host-accessible backend URL (baked into client bundle at build time)
# - For Docker: Use host-accessible URL (e.g., http://localhost:8000)
# - For production: Use your domain (e.g., https://api.yourdomain.com)
# - This is used for CSP headers and any client-side code
# Note: Server-side Next.js API routes use API_BASE_URL (set automatically in docker-compose.yml)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================
# Cookie Security
# ============================================
# Set to 'true' in production with HTTPS
# Set to 'false' for local development/testing
SECURE_COOKIES=false

# ============================================
# Rate Limiting (only active when NODE_ENV=production)
# ============================================
# Time-to-live in seconds for rate limit buckets
THROTTLE_TTL=60000
# Maximum requests per TTL period
THROTTLE_LIMIT=200
